# Add at least one provider key, or paste it in Settings
OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...        # Free models from Google AI Studio (https://aistudio.google.com/apikey)
# OPENROUTER_API_KEY=sk-or-...  # open models (Kimi, DeepSeek, Qwen, GLM...) through OpenRouter

#Google vertex
# Vertex AI Gemini (use ADC, or set a service-account credential JSON)
# VERTEX_AI_PROJECT=my-google-cloud-project
# VERTEX_AI_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# Alternatively, set VERTEX_AI_CREDENTIALS_JSON to the full JSON string.

# Optional overrides
# DOTS_MODEL=gemini:gemini-2.5-flash # free models: gemini-2.5-flash, gemini-2.0-flash, gemini-2.0-flash-lite
# DOTS_REVIEW_MODEL=gemini:gemini-2.0-flash-lite
# DOTS_VOICE_MODEL=gpt-realtime-2.1
# "computer" = OpenAI computer-use tool driving the dot's browser; "off" = DOM browser tools only
DOTS_COMPUTER_TOOL=computer

# LiveKit (Required for LiveKit voice agents)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-api-key
# LIVEKIT_API_SECRET=your-api-secret

# Computers: a cloud computer per dot with E2B, otherwise a Docker container, otherwise a sandbox folder
# E2B_API_KEY=e2b_...
# DOTS_COMPUTER=cloud           # force cloud | docker | local
DOTS_BOX_IMAGE=node:22-bookworm

# Triggers: the API key of a Composio project (platform.composio.dev)
# COMPOSIO_API_KEY=ak_...

# Where the app is served (Composio sign-in redirects back here)
DOTS_PUBLIC_URL=http://localhost:3100
